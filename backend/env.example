# Server Configuration
PORT=3001
NODE_ENV=development

# Database Configuration
# For Docker: use 'postgres' as host (service name in docker-compose)
# For local: use 'localhost'
DB_HOST=postgres
DB_PORT=5432
DB_NAME=flight_search
DB_USER=postgres
DB_PASSWORD=postgres

# TimescaleDB Extension
ENABLE_TIMESCALEDB=true

# CORS Configuration (หลาย origin คั่นด้วย comma ได้ สำหรับเทสมือถือผ่าน IP)
# ตัวอย่าง: CORS_ORIGIN=http://localhost:3000,http://192.168.1.100:3000
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
# Window in milliseconds (default: 60000 = 1 minute)
RATE_LIMIT_WINDOW_MS=60000
# Max requests per window (default: 1000 in dev, 300 in prod)
RATE_LIMIT_MAX_REQUESTS=1000

# ============================================
# Scheduled Jobs Configuration
# ============================================
#
# Enable/disable scheduled background jobs
#
ENABLE_SCHEDULED_JOBS=false

# Startup warmup (separate from scheduled jobs)
# In development, keeping this false avoids long startup preload runs.
DASHBOARD_PRELOAD_ON_STARTUP=false

# Dashboard cache refresh schedule (off-peak)
# Default cron: daily 04:00 (server timezone if TIMEZONE is empty)
DASHBOARD_CACHE_REFRESH_CRON=0 4 * * *
# Example: UTC, Asia/Bangkok
DASHBOARD_CACHE_REFRESH_TIMEZONE=UTC

# Refresh behavior
# Allowed preset: all, focus, 7, 30, 90, 180, 365
DASHBOARD_CACHE_REFRESH_PRESET=focus
# Disable world preset preload for faster dev cycles
DASHBOARD_CACHE_REFRESH_PRELOAD_PRESET=false
DASHBOARD_CACHE_REFRESH_MODE=override
DASHBOARD_CACHE_REFRESH_CLEAR_FIRST=true
DASHBOARD_CACHE_REFRESH_FULL_PRELOAD=false

# Country overview preload (backend-only; no frontend trigger)
DASHBOARD_CACHE_REFRESH_PRELOAD_COUNTRY_OVERVIEW=true
# Batch size per country preload flush (recommended 10-20)
DASHBOARD_CACHE_REFRESH_COUNTRY_BATCH_SIZE=15
# Hard stop when RSS reaches this value
DASHBOARD_CACHE_REFRESH_MAX_RSS_MB=2048

# Optional: run one refresh immediately when server starts and scheduler is enabled
DASHBOARD_CACHE_REFRESH_RUN_ON_START=false


